rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }
    match /game_scores/{scoreId} {
      allow read: if true;
      allow write: if true;
    }
    match /multiplayer_rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
